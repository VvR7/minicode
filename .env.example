# Copy this file to .env for local development. Never commit real credentials.
MINICODE_LOG_LEVEL=info
MINICODE_HOME=/absolute/path/to/.minicode
MINICODE_CORE_HOST=127.0.0.1
MINICODE_CORE_PORT=7437
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-6
# 以上 LLM_* 为 `bun run mc --goal` 运行所需的 Anthropic 兼容模型配置。
