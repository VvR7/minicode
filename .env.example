# Copy this file to .env for local development. Never commit real credentials.
MINICODE_LOG_LEVEL=info
MINICODE_HOME=/absolute/path/to/.minicode
MINICODE_CORE_HOST=127.0.0.1
MINICODE_CORE_PORT=7437
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-6
LLM_CONTEXT_WINDOW_TOKENS=200000
LLM_MAX_OUTPUT_TOKENS=8192
# Trace 默认开启且使用 summary；full 仍会递归脱敏 credential，但会保留业务正文。
MINICODE_TRACE_ENABLED=true
MINICODE_TRACE_PAYLOAD=summary
MINICODE_TRACE_QUEUE_EVENTS=1024
MINICODE_TRACE_MAX_BYTES=33554432
MINICODE_TRACE_SHUTDOWN_MS=2000
# 以上 LLM_* 同时供交互式 TUI 与 `mc --goal` 的 Anthropic 兼容 provider 使用。

# 自动压缩开关不影响手动 /compact；reserve 必须覆盖最大输出预算。
MINICODE_COMPACTION_ENABLED=true
MINICODE_COMPACTION_RESERVE_TOKENS=16384
MINICODE_COMPACTION_KEEP_RECENT_TOKENS=20000
